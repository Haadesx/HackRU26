# Leave empty to run the UI on built-in mock data (with the demo bar).
VITE_API_URL=

# To use the real MedCheck hub, set its address, then restart `npm run dev`:
# VITE_API_URL=http://localhost:8000
#
# Opening the dashboard from another device (like a phone)? Browsers only allow the
# camera on https:// or localhost, so serve the hub and dashboard over HTTPS.
