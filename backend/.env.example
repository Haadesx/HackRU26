# Copy to .env and fill in. Never commit .env.

# SQLAlchemy URL. Local docker-compose DB shown; for TigerData use the service URL
# with the postgresql+psycopg:// scheme and ?sslmode=require.
DATABASE_URL=postgresql+psycopg://medcheck:medcheck@localhost:5433/medcheck
# Used only by pytest.
TEST_DATABASE_URL=postgresql+psycopg://medcheck:medcheck@localhost:5433/medcheck_test

# Long random string. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Comma-separated list of allowed web origins, or * for local dev.
CORS_ORIGINS=http://localhost:5173

# OpenFDA (free key from https://open.fda.gov/apis/authentication/). Optional but avoids low rate limits.
OPENFDA_ENABLED=true
OPENFDA_API_KEY=
OPENFDA_TIMEOUT_S=5

# Twilio SMS. Leave blank to disable the SMS channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ElevenLabs TTS (voice reminders). Twilio supports ElevenLabs as a <Say> provider;
# the project-wide key also lives in the root .env (never committed).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Firebase service-account JSON (path to file, or the raw JSON). Leave blank to disable web push.
FIREBASE_CREDENTIALS_JSON=

# /hub compatibility layer for the React dashboard (frontend). NO LOGIN: every request acts as
# HUB_PATIENT_EMAIL. Turn on only for the local demo; never expose it publicly.
HUB_ENABLED=false
HUB_PATIENT_EMAIL=demo.patient@example.com
# Inference gateway (services/api) used to read label photos.
HUB_INFERENCE_URL=http://127.0.0.1:8300
HUB_INFERENCE_API_KEY=
HUB_INFERENCE_TIMEOUT_S=90
# Minutes a scan waits in asking_patient before it goes to the caregiver.
HUB_ASK_PATIENT_MINUTES=3

# Worker
DOSE_HORIZON_HOURS=48
WORKER_DISPATCH_INTERVAL_S=30
WORKER_MISSED_INTERVAL_S=60
WORKER_GENERATE_INTERVAL_S=900
WORKER_RETRY_INTERVAL_S=300
