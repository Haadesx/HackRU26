# MedCheck — project-wide environment template. Copy to `.env` and fill in.
# Never commit `.env`. Names only here; values live on each machine.

# ── ElevenLabs (voice / TTS) ──────────────────────────────────────────────
# Dashboard → Profile → API keys. Used for voice reminders (e.g. Twilio
# <Say> provider) and demo voiceovers.
ELEVENLABS_API_KEY=
# Optional pins for consistent reminders (leave empty to use the service default)
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Inference gateway (services/api, :8300) ──────────────────────────────
# Real secrets for the shared vLLM stay in ~/.medcheck/vllm.env (mode 600).
# MEDCHECK_API_MODE=real
# MEDCHECK_VLM_ENABLED=1
# MEDCHECK_YOLO_MODEL=models/yolo11n.onnx

# ── Backend (services/api → backend/): see backend/.env.example ──────────
# DATABASE_URL / TEST_DATABASE_URL, JWT_SECRET_KEY, OPENFDA_API_KEY,
# TWILIO_*, FIREBASE_CREDENTIALS_JSON live in backend/.env (never committed).
